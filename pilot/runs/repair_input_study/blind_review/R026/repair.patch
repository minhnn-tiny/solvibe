diff --git a/src/libraries/TickIterator.sol b/src/libraries/TickIterator.sol
index a4d6577..e29d4d0 100644
--- a/src/libraries/TickIterator.sol
+++ b/src/libraries/TickIterator.sol
@@ -139,9 +139,19 @@ library TickIteratorLib {
 
         if (startTick == self.endTick) return;
 
-        (int16 wordPos,) = TickLib.position(startTick.compress(self.tickSpacing));
+        (int16 wordPos, uint8 bitPos) = TickLib.position(startTick.compress(self.tickSpacing));
         self.currentWord = self.manager.getPoolBitmapInfo(self.poolId, wordPos);
 
+        if (
+            startTick == startTick.normalizeUnchecked(self.tickSpacing)
+                && self.currentWord.isInitialized(bitPos)
+        ) {
+            if (bitPos == 0) return;
+
+            (bool hasLowerInitializedTick,) = self.currentWord.nextBitPosLte(bitPos - 1);
+            if (!hasLowerInitializedTick) return;
+        }
+
         _advanceToNextDown(self);
     }
 
