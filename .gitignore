# tracked because the OpenAI validation costs money to rerun.
data_collection/downloaded_findings/
data_collection/batch_*_extracted_contracts/tier_*/

# Pilot: cloned target repositories and agent working copies
pilot/repos/
pilot/runs/**/workspace/
